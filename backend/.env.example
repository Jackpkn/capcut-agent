GROQ_API_KEY=
GEMINI_API_KEY=

# LLM routing: auto | ollama | groq | gemini
LLM_PROVIDER=auto
# Primary in auto mode (local first — no rate limits)
LLM_PRIMARY=ollama

# Ollama (local, free) — https://ollama.com
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:e4b
# Faster model for orchestrator routing (smaller = quicker "hi" / route decisions)
OLLAMA_ORCHESTRATOR_MODEL=llama3.2:latest
# OLLAMA_THINK=true  # Gemma 4: <|think|> + reasoning in UI (see Ollama gemma4 docs)
# OLLAMA_GEMMA4_TEMP=1.0   # recommended; omit to use 1.0 for gemma4 automatically
# OLLAMA_GEMMA4_TOP_P=0.95
# OLLAMA_GEMMA4_TOP_K=64

# Terminal logs: INFO (default) | DEBUG for more detail
LOG_LEVEL=INFO

GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
